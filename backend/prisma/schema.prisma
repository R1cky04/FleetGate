// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== ENUMS =====

enum UserRole {
  DEV         // Owner/dev global account (system maintenance)
  CLIENT      // Apenas ficha, sem login
  FLEET       // Gere veículos
  STAFF       // Contratos, devoluções, reservas + permissões FLEET
  ADMIN       // Gerente de estação, move staff, dá permissões
  IT          // Admin técnico da rent-a-car (não manutenção global)
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  RENTED
  MAINTENANCE
  IN_REPAIR
  OUT_OF_SERVICE
  RETIRED
}

enum VehicleRepairStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
  OVERDUE
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIAL
  REFUNDED
  FAILED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  BANK_TRANSFER
  MB_WAY
  MULTIBANCO
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  INSPECTION
  CLEANING
  ACCIDENT_REPAIR
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VehicleTransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

enum NotificationType {
  RESERVATION_CONFIRMED
  RESERVATION_CANCELLED
  CONTRACT_CREATED
  CONTRACT_COMPLETED
  CONTRACT_CANCELLED
  PAYMENT_RECEIVED
  MAINTENANCE_DUE
  VEHICLE_UPGRADE
  VEHICLE_TRANSFER
  SYSTEM_ALERT
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum LockStatus {
  LOCKED
  UNLOCKED
  EXPIRED
}

enum TenantDbMode {
  SHARED
  DEDICATED
}

model Tenant {
  id            Int              @id @default(autoincrement())
  code          String           @unique
  name          String
  dbMode        TenantDbMode     @default(SHARED)
  dbName        String?
  dbHost        String?
  dbPort        String?
  dbUser        String?
  dbPassword    String?
  dbUrl         String?
  isActive      Boolean          @default(true)
  notes         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  users         User[]
  clientProfiles ClientProfile[]
  staffProfiles StaffProfile[]
  userPermissions UserPermission[]
  stations      Station[]
  departments   Department[]
  vehicleGroups VehicleGroup[]
  vehicles      Vehicle[]
  reservations  Reservation[]
  contracts     Contract[]
  payments      Payment[]
  maintenances  Maintenance[]
  repairs       VehicleRepair[]
  transfers     VehicleTransfer[]
  additionalDrivers AdditionalDriver[]
  damageTypes   DamageType[]
  notifications Notification[]
  activityLogs  ActivityLog[]
  recordLocks   RecordLock[]
  systemConfigs SystemConfig[]

  @@index([isActive])
  @@index([dbMode])
}

// ===== USERS & AUTH =====

model User {
  id                Int               @id @default(autoincrement())
  tenantId          Int?
  userCode          String            @unique
  email             String?           @unique
  password          String?
  role              UserRole          @default(CLIENT)
  status            UserStatus        @default(ACTIVE)
  
  // Informação pessoal
  firstName         String
  lastName          String
  fullName          String            // firstName + lastName
  phone             String
  alternativePhone  String?
  cpf               String?           @unique
  dateOfBirth       DateTime?
  
  // Endereço
  address           String?
  city              String?
  postalCode        String?
  country           String            @default("Portugal")
  
  stationId         Int?
  
  // Configurações
  profileImage      String?
  emailVerified     Boolean           @default(false)
  phoneVerified     Boolean           @default(false)
  acceptedTerms     Boolean           @default(false)
  acceptedMarketing Boolean           @default(false)
  
  // Timestamps
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  lastLoginAt       DateTime?
  createdBy         Int?
  
  // Relações
  tenant            Tenant?           @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  station           Station?          @relation(fields: [stationId], references: [id])
  clientProfile     ClientProfile?
  staffProfile      StaffProfile?
  permissions       UserPermission[]
  reservations      Reservation[]
  contracts         Contract[]
  payments          Payment[]
  activityLogs      ActivityLog[]
  createdReservations Reservation[]  @relation("CreatedBy")
  createdContracts  Contract[]       @relation("CreatedBy")
  cancelledContracts Contract[]      @relation("CancelledBy")
  additionalDriverContracts AdditionalDriver[]
  notifications     Notification[]
  vehicleTransfersAsDriver VehicleTransfer[] @relation("TransferDriver")
  vehicleTransfersCreated  VehicleTransfer[] @relation("TransferCreatedBy")
  repairsOpened     VehicleRepair[]  @relation("RepairOpenedBy")
  repairsClosed     VehicleRepair[]  @relation("RepairClosedBy")
  recordLocks       RecordLock[]
  
  @@index([email])
  @@index([cpf])
  @@index([tenantId])
  @@index([stationId])
  @@index([role, status])
}

model ClientProfile {
  tenantId          Int?
  userId            Int      @id
  nif               String?  @unique
  licenseNumber     String?  @unique
  licenseExpiry     DateTime?
  licenseIssueDate  DateTime?
  licenseCountry    String?
  idCardNumber      String?  @unique
  idCardExpiry      DateTime?
  customerType      String?
  companyName       String?
  companyTaxId      String?
  brokerName        String?
  brokerReference   String?
  isBlacklisted     Boolean  @default(false)
  blacklistReason   String?
  blacklistedAt     DateTime?
  blacklistedBy     Int?
  clientRating      Float?
  totalRentals      Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([nif])
}

model StaffProfile {
  tenantId          Int?
  userId            Int      @id
  employeeNumber    String   @unique
  hireDate          DateTime?
  departmentId      String?
  stationId         Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  station           Station     @relation(fields: [stationId], references: [id])
  department        Department? @relation(fields: [departmentId], references: [id])

  @@index([tenantId])
  @@index([stationId])
  @@index([departmentId])
}

model UserPermission {
  id          String   @id @default(uuid())
  tenantId     Int?
  userId      Int
  permission  String   // e.g., "vehicle.upgrade", "station.manage", "staff.move"
  grantedBy   Int
  grantedAt   DateTime @default(now())
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([userId])
  @@index([permission])
}

// ===== ORGANIZATIONAL =====

model Station {
  id              Int         @id @default(autoincrement())
  tenantId        Int?
  name            String
  email           String?
  phone           String?
  
  // Endereço
  address         String?
  city            String?
  postalCode      String?
  country         String      @default("Portugal")
  latitude        Float?
  longitude       Float?
  
  // Configurações
  isActive        Boolean     @default(true)
  isPickupPoint   Boolean     @default(true)
  isReturnPoint   Boolean     @default(true)
  isFictitious    Boolean     @default(false) // Para estações especiais (roubados, manutenção)
  purpose         String?     // "STOLEN", "MAINTENANCE", "RETIRED", etc.
  openingHours    String?     // JSON string
  
  // Timestamps
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  // Relações
  tenant          Tenant?     @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  users           User[]
  staffProfiles   StaffProfile[]
  vehicles        Vehicle[]
  reservationsPickup   Reservation[] @relation("PickupStation")
  reservationsReturn   Reservation[] @relation("ReturnStation")
  contractsPickup      Contract[]    @relation("PickupStation")
  contractsReturn      Contract[]    @relation("ReturnStation")
  transfersFrom        VehicleTransfer[] @relation("TransferFrom")
  transfersTo          VehicleTransfer[] @relation("TransferTo")
  repairsOpened        VehicleRepair[] @relation("RepairOpenedAt")
  repairsClosed        VehicleRepair[] @relation("RepairClosedAt")
  recordLocks      RecordLock[]
  
  @@index([tenantId])
  @@index([isActive])
}

model Department {
  id          String   @id @default(uuid())
  tenantId    Int?
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  staffProfiles StaffProfile[]

  @@index([tenantId])
}

// ===== VEHICLES =====

model VehicleGroup {
  id              String    @id @default(uuid())
  tenantId        Int?
  code            String    @unique
  name            String
  description     String?
  category        String    // Económico, Compacto, SUV, etc.
  
  // Especificações
  seats           Int
  doors           Int
  transmission    String    // Manual, Automático
  fuelType        String    // Gasolina, Diesel, Elétrico, Híbrido
  airConditioning Boolean   @default(true)
  
  // Preços base
  dailyRate       Float
  weeklyRate      Float?
  monthlyRate     Float?
  depositAmount   Float
  
  // Kilometragem
  kmIncluded      Int       @default(0) // 0 = ilimitado
  extraKmCost     Float     @default(0)
  
  // Configurações
  minRentalDays   Int       @default(1)
  maxRentalDays   Int       @default(365)
  minDriverAge    Int       @default(21)
  minLicenseYears Int       @default(1)
  
  // Imagens e docs
  image           String?
  features        String?   // JSON array
  
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  vehicles        Vehicle[]
  
  @@index([tenantId])
  @@index([code])
  @@index([category])
}

model Vehicle {
  id              Int             @id @default(autoincrement())
  tenantId        Int?
  groupId         String
  stationId       Int
  
  // Identificação
  licensePlate    String          @unique
  vin             String          @unique
  make            String
  model           String
  year            Int
  color           String
  
  // Status
  status          VehicleStatus   @default(AVAILABLE)
  currentKm       Int             @default(0)
  lastServiceKm   Int             @default(0)
  nextServiceKm   Int?
  
  // Documentos
  registrationDate DateTime?
  registrationExpiry DateTime?
  insuranceNumber String?
  insuranceExpiry DateTime?
  inspectionExpiry DateTime?
  
  // Configurações
  notes           String?
  images          String?         // JSON array
  isStolen        Boolean         @default(false)
  isSold          Boolean         @default(false)
  isBlocked       Boolean         @default(false)
  isActive        Boolean         @default(true)
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Relações
  tenant          Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  group           VehicleGroup    @relation(fields: [groupId], references: [id])
  station         Station         @relation(fields: [stationId], references: [id])
  reservations    Reservation[]
  contracts       Contract[]
  maintenances    Maintenance[]
  repairs         VehicleRepair[]
  transfers       VehicleTransfer[]
  
  @@index([tenantId])
  @@index([licensePlate])
  @@index([groupId])
  @@index([stationId])
  @@index([status])
  @@index([isStolen])
  @@index([isSold])
  @@index([isBlocked])
}

// ===== RESERVATIONS & CONTRACTS =====

model Reservation {
  id                Int                 @id @default(autoincrement())
  tenantId          Int?
  reservationNumber String              @unique
  
  // Cliente e veículo
  clientId          Int
  vehicleId         Int?
  vehicleGroupId    String?
  
  // Localizações
  pickupStationId   Int
  returnStationId   Int
  
  // Datas
  pickupDate        DateTime
  returnDate        DateTime
  
  // Status
  status            ReservationStatus   @default(PENDING)
  
  // Preços
  dailyRate         Float
  totalDays         Int
  estimatedTotal    Float
  depositPaid       Float               @default(0)
  vehicleAmount     Float?
  extrasAmount      Float?
  insuranceAmount   Float?
  taxRate           Float?
  taxAmount         Float?
  totalWithTax      Float?
  
  // Extras
  includeInsurance  Boolean             @default(false)
  insuranceCost     Float               @default(0)
  insuranceType     String?
  additionalDrivers Int                 @default(0)
  additionalDriverCost Float            @default(0)
  extras            String?             // JSON - Extras selecionados
  
  // Observações
  clientNotes       String?             // Observações visíveis para o cliente
  stationNotes      String?             // Observações internas da estação
  
  // Criação
  createdById       Int
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  confirmedAt       DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  
  // Locking
  lockedBy          Int?                // User ID que tem lock exclusivo
  lockedAt          DateTime?           // Quando foi feito o lock
  lockExpiresAt     DateTime?           // Quando o lock expira (timeout)
  
  // Relações
  tenant            Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  client            User                @relation(fields: [clientId], references: [id])
  vehicle           Vehicle?            @relation(fields: [vehicleId], references: [id])
  pickupStation     Station             @relation("PickupStation", fields: [pickupStationId], references: [id])
  returnStation     Station             @relation("ReturnStation", fields: [returnStationId], references: [id])
  createdBy         User                @relation("CreatedBy", fields: [createdById], references: [id])
  contract          Contract?
  
  @@index([tenantId])
  @@index([reservationNumber])
  @@index([clientId])
  @@index([vehicleId])
  @@index([status])
  @@index([pickupDate])
}

model Contract {
  id                Int             @id @default(autoincrement())
  tenantId          Int?
  contractNumber    String          @unique
  reservationId     Int?            @unique
  
  // Cliente e veículo
  clientId          Int
  vehicleId         Int
  
  // Upgrade tracking
  originalVehicleGroupId String?      // Se houve upgrade, grupo original
  upgradeApprovedBy Int?              // Admin que aprovou upgrade
  upgradeReason     String?           // Razão do upgrade
  upgradeApprovedAt DateTime?
  upgradeCost       Float             @default(0)
  
  // Localizações
  pickupStationId   Int
  returnStationId   Int
  
  // Datas planejadas
  pickupDate        DateTime
  plannedReturnDate DateTime
  
  // Datas reais
  actualPickupDate  DateTime?
  actualReturnDate  DateTime?
  
  // Status
  status            ContractStatus  @default(DRAFT)

  // Termos e condicoes (obrigatorio ao abrir contrato)
  termsVersion      String?
  termsText         String?
  termsAcceptedAt   DateTime?
  termsSignature    String?
  
  // Kilometragem
  kmOut             Int
  kmIn              Int?
  kmIncluded        Int             @default(0)
  extraKm           Int             @default(0)
  extraKmCost       Float           @default(0)
  
  // Combustível
  fuelLevelOut      String          // 1/4, 1/2, 3/4, Full
  fuelLevelIn       String?
  fuelCharge        Float           @default(0)
  
  // Preços
  dailyRate         Float
  totalDays         Int
  subtotal          Float
  insuranceCost     Float           @default(0)
  insuranceType     String?
  extrasCost        Float           @default(0)
  lateFee           Float           @default(0)
  damageCost        Float           @default(0)
  discountAmount    Float           @default(0)
  totalAmount       Float
  vehicleAmount     Float?
  extrasAmount      Float?
  insuranceAmount   Float?
  taxRate           Float?
  taxAmount         Float?
  totalWithTax      Float?
  paidAmount        Float           @default(0)
  balanceDue        Float           @default(0)
  
  // Depósito
  depositAmount     Float
  depositReturned   Boolean         @default(false)
  depositReturnedAt DateTime?
  
  // Extras
  extras            String?         // JSON - Copiado da reserva se existir
  
  // Danos e observações
  damagesOut        String?         // JSON array
  damagesIn         String?         // JSON array
  damageOnReturn    String?         // Descrição de danos na devolução
  clientNotes       String?         // Observações visíveis para o cliente
  stationNotes      String?         // Observações internas da estação

  // Pre-fecho (inspecao e assinatura)
  preCloseAt        DateTime?
  preCloseClientSignature String?
  preCloseStaffSignature  String?
  preCloseNotes     String?
  
  // Assinaturas
  clientSignature   String?         // Assinatura na abertura do contrato
  staffSignature    String?         // Assinatura do staff na abertura
  closeClientSignature String?      // Assinatura no fecho
  closeStaffSignature  String?      // Assinatura do staff no fecho
  paymentConfirmedAt   DateTime?
  
  // Criação e cancelamento
  createdById       Int
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelledBy       Int?
  cancellationReason String?
  
  // Locking
  lockedBy          Int?            // User ID que tem lock exclusivo
  lockedAt          DateTime?       // Quando foi feito o lock
  lockExpiresAt     DateTime?       // Quando o lock expira (timeout)
  
  // Relações
  tenant            Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  reservation       Reservation?    @relation(fields: [reservationId], references: [id])
  client            User            @relation(fields: [clientId], references: [id])
  vehicle           Vehicle         @relation(fields: [vehicleId], references: [id])
  pickupStation     Station         @relation("PickupStation", fields: [pickupStationId], references: [id])
  returnStation     Station         @relation("ReturnStation", fields: [returnStationId], references: [id])
  createdBy         User            @relation("CreatedBy", fields: [createdById], references: [id])
  cancelledByUser   User?           @relation("CancelledBy", fields: [cancelledBy], references: [id])
  payments          Payment[]
  additionalDrivers AdditionalDriver[]
  
  @@index([tenantId])
  @@index([contractNumber])
  @@index([clientId])
  @@index([vehicleId])
  @@index([status])
  @@index([pickupDate])
}

// ===== PAYMENTS =====

model Payment {
  id              String        @id @default(uuid())
  tenantId        Int?
  contractId      Int
  clientId        Int
  
  amount          Float
  paymentMethod   PaymentMethod
  status          PaymentStatus @default(PENDING)
  
  // Detalhes
  paymentType     String        // Depósito, Pagamento Final, Extras, etc.
  transactionId   String?       @unique
  reference       String?
  
  notes           String?
  
  processedBy     String?
  processedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  // Relações
  tenant          Tenant?       @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  contract        Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  client          User          @relation(fields: [clientId], references: [id])
  
  @@index([tenantId])
  @@index([contractId])
  @@index([clientId])
  @@index([status])
}

// ===== MAINTENANCE =====

model Maintenance {
  id              String              @id @default(uuid())
  tenantId        Int?
  vehicleId       Int
  
  type            MaintenanceType
  status          MaintenanceStatus   @default(SCHEDULED)
  
  // Datas
  scheduledDate   DateTime
  startedAt       DateTime?
  completedAt     DateTime?
  
  // Detalhes
  description     String
  notes           String?
  cost            Float               @default(0)
  
  // Kilometragem
  currentKm       Int
  nextServiceKm   Int?
  
  // Fornecedor
  provider        String?
  invoiceNumber   String?
  
  performedBy     String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  tenant          Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  vehicle         Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([vehicleId])
  @@index([status])
  @@index([scheduledDate])
}

// ===== VEHICLE REPAIRS (IMPROPRIEDADES) =====

model VehicleRepair {
  id              String              @id @default(uuid())
  tenantId        Int?
  repairNumber    String              @unique
  vehicleId       Int
  
  // Estações
  fromStationId   Int                 // Estação onde foi marcado em reparo
  closedAtStationId Int?               // Estação onde foi fechado
  
  // Status
  status          VehicleRepairStatus @default(OPEN)
  
  // Datas
  openedAt        DateTime            @default(now())
  startedAt       DateTime?
  closedAt        DateTime?
  
  // Razão
  reason          String              // Motivo do reparo
  description     String?
  
  // Responsáveis
  openedById      Int                 // User que abriu
  closedById      Int?                // User que fechou
  
  // Observações
  notes           String?
  internalNotes   String?
  
  // Custo estimado e real
  estimatedCost   Float               @default(0)
  actualCost      Float?
  
  // Kilometragem
  kmWhenOpened    Int
  kmWhenClosed    Int?
  
  // Locks para evitar conflitos
  lockedBy        Int?                // User que tem o lock (para fechar)
  lockedAt        DateTime?           // Quando foi lockado
  lockedExpires   DateTime?           // Quando o lock expira
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  // Relações
  tenant          Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  vehicle         Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  fromStation     Station             @relation("RepairOpenedAt", fields: [fromStationId], references: [id])
  closedAtStation Station?            @relation("RepairClosedAt", fields: [closedAtStationId], references: [id])
  openedBy        User                @relation("RepairOpenedBy", fields: [openedById], references: [id])
  closedBy        User?               @relation("RepairClosedBy", fields: [closedById], references: [id])
  
  @@index([tenantId])
  @@index([vehicleId])
  @@index([status])
  @@index([openedAt])
  @@index([fromStationId])
  @@index([closedAtStationId])
  @@index([lockedExpires])
}

// ===== VEHICLE TRANSFERS (IMPROS) =====

model VehicleTransfer {
  id                String                 @id @default(uuid())
  tenantId          Int?
  transferNumber    String                 @unique
  vehicleId         Int
  
  // Estações
  fromStationId     Int
  toStationId       Int
  
  // Condutor responsável
  driverId          Int
  
  // Datas
  scheduledDate     DateTime
  departureDate     DateTime?
  arrivalDate       DateTime?
  
  // Status
  status            VehicleTransferStatus  @default(PENDING)
  
  // Kilometragem
  kmAtDeparture     Int?
  kmAtArrival       Int?
  
  // Observações
  reason            String                 // Motivo da transferência
  clientNotes       String?                // Observações visíveis (se for para cliente)
  stationNotes      String?                // Observações internas da estação
  
  // Custos (se aplicável)
  cost              Float                  @default(0)
  
  // Criação e timestamps
  createdById       Int
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancellationReason String?
  
  // Relações
  tenant            Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  vehicle           Vehicle                @relation(fields: [vehicleId], references: [id])
  fromStation       Station                @relation("TransferFrom", fields: [fromStationId], references: [id])
  toStation         Station                @relation("TransferTo", fields: [toStationId], references: [id])
  driver            User                   @relation("TransferDriver", fields: [driverId], references: [id])
  createdBy         User                   @relation("TransferCreatedBy", fields: [createdById], references: [id])
  
  @@index([tenantId])
  @@index([transferNumber])
  @@index([vehicleId])
  @@index([status])
  @@index([scheduledDate])
}

// ===== ADDITIONAL DRIVERS =====

model AdditionalDriver {
  id              String    @id @default(uuid())
  tenantId        Int?
  contractId      Int
  driverId        Int?      // Se for cliente existente
  
  // Dados pessoais
  fullName        String
  email           String?
  phone           String
  cpf             String?
  nif             String?
  dateOfBirth     DateTime
  
  // Carta de condução
  licenseNumber   String
  licenseExpiry   DateTime
  licenseIssueDate DateTime?
  licenseCountry  String    @default("Portugal")
  
  // Documentos
  idCardNumber    String
  idCardExpiry    DateTime?
  
  address         String?
  city            String?
  postalCode      String?
  country         String    @default("Portugal")
  
  // Custo
  dailyCost       Float     @default(0)
  totalCost       Float     @default(0)
  
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  contract        Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  driver          User?     @relation(fields: [driverId], references: [id])
  
  @@index([tenantId])
  @@index([contractId])
  @@index([driverId])
  @@index([licenseNumber])
}

// ===== DAMAGE TYPES =====

model DamageType {
  id              String    @id @default(uuid())
  tenantId        Int?
  code            String    @unique
  name            String
  description     String?
  category        String    // EXTERIOR, INTERIOR, MECHANICAL, GLASS
  severity        String    // MINOR, MODERATE, MAJOR, SEVERE
  
  // Custos padrão
  estimatedCost   Float
  minCost         Float?
  maxCost         Float?
  
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([code])
  @@index([category])
  @@index([severity])
}

// ===== NOTIFICATIONS =====

model Notification {
  id              String              @id @default(uuid())
  tenantId        Int?
  userId          Int
  type            NotificationType
  status          NotificationStatus  @default(UNREAD)
  
  title           String
  message         String
  
  // Relacionado a
  entityType      String?             // Contract, Reservation, Vehicle, etc.
  entityId        String?
  
  // Ações
  actionUrl       String?
  actionLabel     String?
  
  readAt          DateTime?
  createdAt       DateTime            @default(now())
  
  tenant          Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ===== ACTIVITY LOG =====

model ActivityLog {
  id          String   @id @default(uuid())
  tenantId     Int?
  userId      Int
  action      String   // e.g., "user.created", "contract.completed"
  entityType  String   // User, Contract, Vehicle, etc.
  entityId    String
  details     String?  // JSON
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ===== RECORD LOCKS (Multi-tenancy & Exclusive Editing) =====

model RecordLock {
  id              String    @id @default(uuid())
  tenantId        Int?
  entityType      String    // "Contract", "Reservation", "Vehicle"
  entityId        String    // ID do registo
  lockedBy        Int       // User ID que tem o lock
  stationId       Int       // Station onde o lock foi feito (multi-tenancy isolation)
  
  // Lock control
  acquiredAt      DateTime  @default(now())
  expiresAt       DateTime  // Quando o lock expira
  isActive        Boolean   @default(true)
  
  // Context
  action          String    // "edit", "preview", "process"
  ipAddress       String?
  userAgent       String?
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relações
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user            User      @relation(fields: [lockedBy], references: [id], onDelete: Cascade)
  station         Station   @relation(fields: [stationId], references: [id], onDelete: Cascade)
  
  @@index([tenantId])
  @@unique([entityType, entityId, stationId]) // Apenas um lock ativo por registo/estação
  @@index([entityType, entityId])
  @@index([lockedBy])
  @@index([stationId])
  @@index([expiresAt])
}

// ===== SYSTEM CONFIG =====

model SystemConfig {
  id          String   @id @default(uuid())
  tenantId    Int?
  version     String?
  updatedBy   String?
  configJson  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  @@index([tenantId])
}
