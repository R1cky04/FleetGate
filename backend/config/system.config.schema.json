{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FleetGate System Configuration",
  "description": "Configuration file for FleetGate initial setup and management",
  "type": "object",
  "required": ["version", "departments", "stations", "vehicleGroups", "systemSettings"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Configuration file version"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp"
    },
    "updatedBy": {
      "type": "string",
      "description": "User who last updated this configuration"
    },
    "departments": {
      "type": "array",
      "description": "Company departments",
      "items": {
        "type": "object",
        "required": ["name", "isActive"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "isActive": { "type": "boolean" }
        }
      }
    },
    "stations": {
      "type": "array",
      "description": "Rental stations",
      "items": {
        "type": "object",
        "required": ["code", "name", "email", "phone", "address", "city", "postalCode", "country"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z0-9]+$" },
          "name": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "phone": { "type": "string" },
          "address": { "type": "string" },
          "city": { "type": "string" },
          "postalCode": { "type": "string" },
          "country": { "type": "string" },
          "latitude": { "type": "number" },
          "longitude": { "type": "number" },
          "isActive": { "type": "boolean" },
          "isPickupPoint": { "type": "boolean" },
          "isReturnPoint": { "type": "boolean" },
          "isFictitious": { "type": "boolean" },
          "purpose": { "type": "string" },
          "openingHours": { "type": "object" }
        }
      }
    },
    "vehicleGroups": {
      "type": "array",
      "description": "Vehicle groups/categories",
      "items": {
        "type": "object",
        "required": ["code", "name", "category", "seats", "doors", "transmission", "fuelType", "dailyRate", "depositAmount"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z0-9]+$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "category": { "type": "string" },
          "seats": { "type": "integer", "minimum": 2 },
          "doors": { "type": "integer", "minimum": 2 },
          "transmission": { "type": "string", "enum": ["Manual", "Automático"] },
          "fuelType": { "type": "string" },
          "airConditioning": { "type": "boolean" },
          "dailyRate": { "type": "number", "minimum": 0 },
          "weeklyRate": { "type": "number", "minimum": 0 },
          "monthlyRate": { "type": "number", "minimum": 0 },
          "depositAmount": { "type": "number", "minimum": 0 },
          "kmIncluded": { "type": "integer", "minimum": 0 },
          "extraKmCost": { "type": "number", "minimum": 0 },
          "minRentalDays": { "type": "integer", "minimum": 1 },
          "maxRentalDays": { "type": "integer", "minimum": 1 },
          "minDriverAge": { "type": "integer", "minimum": 18 },
          "minLicenseYears": { "type": "integer", "minimum": 0 },
          "features": { "type": "array", "items": { "type": "string" } },
          "isActive": { "type": "boolean" }
        }
      }
    },
    "extras": {
      "type": "array",
      "description": "Configurable extras and add-ons",
      "items": {
        "type": "object",
        "required": ["code", "name", "unit", "price"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "unit": { "type": "string", "enum": ["per_day", "per_rental"] },
          "price": { "type": "number", "minimum": 0 },
          "stockByStation": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          },
          "isActive": { "type": "boolean" }
        }
      }
    },
    "customerTypes": {
      "type": "array",
      "description": "Customer types supported by the system",
      "items": {
        "type": "object",
        "required": ["code", "name"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "isActive": { "type": "boolean" }
        }
      }
    },
    "documentTypes": {
      "type": "array",
      "description": "Document types and validation rules",
      "items": {
        "type": "object",
        "required": ["code", "name"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "country": { "type": "string" },
          "minLength": { "type": "integer", "minimum": 1 },
          "maxLength": { "type": "integer", "minimum": 1 },
          "pattern": { "type": "string" },
          "isActive": { "type": "boolean" }
        }
      }
    },
    "damageTypes": {
      "type": "array",
      "description": "Predefined damage types catalog",
      "items": {
        "type": "object",
        "required": ["name", "category", "severity", "estimatedCost"],
        "properties": {
          "name": { "type": "string" },
          "category": { "type": "string", "enum": ["EXTERIOR", "INTERIOR", "MECHANICAL", "GLASS"] },
          "severity": { "type": "string", "enum": ["MINOR", "MODERATE", "MAJOR", "SEVERE"] },
          "description": { "type": "string" },
          "estimatedCost": { "type": "number", "minimum": 0 },
          "minCost": { "type": "number", "minimum": 0 },
          "maxCost": { "type": "number", "minimum": 0 }
        }
      }
    },
    "insuranceTypes": {
      "type": "array",
      "description": "Insurance types and default pricing",
      "items": {
        "type": "object",
        "required": ["code", "name", "dailyCost"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "dailyCost": { "type": "number", "minimum": 0 },
          "isDefault": { "type": "boolean" },
          "isActive": { "type": "boolean" }
        }
      }
    },
    "systemUsers": {
      "type": "array",
      "description": "Initial system users (staff)",
      "items": {
        "type": "object",
        "required": ["email", "role", "firstName", "lastName", "phone"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "role": { "type": "string", "enum": ["IT", "ADMIN", "STAFF", "FLEET"] },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "phone": { "type": "string" },
          "department": { "type": "string" },
          "station": { "type": ["string", "null"] },
          "permissions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "paymentProfiles": {
      "type": "array",
      "description": "Payment methods per rent-a-car configuration",
      "items": {
        "type": "object",
        "required": ["code", "name", "methods"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "name": { "type": "string" },
          "rentACarCode": { "type": "string" },
          "methods": { "type": "array", "items": { "type": "string" } },
          "isActive": { "type": "boolean" }
        }
      }
    },
    "systemSettings": {
      "type": "object",
      "description": "Global system settings",
      "required": ["currency", "locale", "timezone"],
      "properties": {
        "defaultPassword": { "type": "string" },
        "requirePasswordChange": { "type": "boolean" },
        "defaultContractDays": { "type": "integer", "minimum": 1 },
        "defaultDepositPercentage": { "type": "number", "minimum": 0, "maximum": 100 },
        "maxAdvanceBookingDays": { "type": "integer", "minimum": 1 },
        "minAdvanceBookingHours": { "type": "integer", "minimum": 0 },
        "lateFeePerDay": { "type": "number", "minimum": 0 },
        "fuelChargeEmpty": { "type": "number", "minimum": 0 },
        "fuelChargeThreeQuarters": { "type": "number", "minimum": 0 },
        "fuelChargeHalf": { "type": "number", "minimum": 0 },
        "fuelChargeQuarter": { "type": "number", "minimum": 0 },
        "additionalDriverCostPerDay": { "type": "number", "minimum": 0 },
        "insuranceDailyCost": { "type": "number", "minimum": 0 },
        "defaultInsuranceType": { "type": "string" },
        "gpsRentalPerDay": { "type": "number", "minimum": 0 },
        "childSeatPerDay": { "type": "number", "minimum": 0 },
        "cleaningFee": { "type": "number", "minimum": 0 },
        "paymentMethods": {
          "type": "array",
          "items": { "type": "string" }
        },
        "depositRules": {
          "type": "object",
          "properties": {
            "defaultDepositPercentage": { "type": "number", "minimum": 0, "maximum": 100 },
            "minDepositAmount": { "type": "number", "minimum": 0 },
            "maxDepositAmount": { "type": "number", "minimum": 0 }
          }
        },
        "fuelLevels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "kmPolicy": {
          "type": "object",
          "properties": {
            "defaultIncludedKm": { "type": "integer", "minimum": 0 },
            "extraKmCost": { "type": "number", "minimum": 0 }
          }
        },
        "contractExtensionPolicy": {
          "type": "object",
          "properties": {
            "allowSameRateExtension": { "type": "boolean" },
            "allowedRoles": { "type": "array", "items": { "type": "string" } }
          }
        },
        "vatRates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["country", "rate"],
            "properties": {
              "country": { "type": "string" },
              "rate": { "type": "number", "minimum": 0, "maximum": 1 },
              "includeInPrices": { "type": "boolean" }
            }
          }
        },
        "termsAndConditions": {
          "type": "object",
          "properties": {
            "version": { "type": "string" },
            "title": { "type": "string" },
            "text": { "type": "string" },
            "lastUpdated": { "type": "string", "format": "date-time" }
          }
        },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "locale": { "type": "string" },
        "timezone": { "type": "string" }
      }
    }
  }
}
